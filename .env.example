# Copia este fichero como .env para cambiar los valores por defecto de docker-compose.yml

# Puerto del equipo en el que se abre el frontend: http://localhost:4200
WEB_PORT=4200

# Dónde está el backend visto desde el contenedor. Con el backend en Docker en este mismo equipo
# publicando el puerto 8081 (APP_PORT=8081 en su .env):
BACKEND_URL=http://host.docker.internal:8081
